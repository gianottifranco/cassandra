#!/bin/sh

# cassandra-stress wrapper for Cassandra Rust rewrite

SCRIPT_DIR=$(dirname "$0")
CASSANDRA_HOME=$(cd "$SCRIPT_DIR/../.." && pwd)

# Execute the Rust cassandra-tools binary with the cassandra-stress subcommand
if [ -x "$CASSANDRA_HOME/rust/target/release/cassandra-tools" ]; then
    exec "$CASSANDRA_HOME/rust/target/release/cassandra-tools" cassandra-stress "$@"
elif [ -x "$CASSANDRA_HOME/rust/target/debug/cassandra-tools" ]; then
    exec "$CASSANDRA_HOME/rust/target/debug/cassandra-tools" cassandra-stress "$@"
else
    cd "$CASSANDRA_HOME/rust" || exit 1
    exec cargo run --bin cassandra-tools --quiet -- cassandra-stress "$@"
fi
