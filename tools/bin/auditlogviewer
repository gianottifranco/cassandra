#!/bin/sh

# auditlogviewer wrapper for Cassandra Rust rewrite

SCRIPT_DIR=$(dirname "$0")
CASSANDRA_HOME=$(cd "$SCRIPT_DIR/../.." && pwd)

# Execute the Rust cassandra-tools binary with the auditlogviewer subcommand
if [ -x "$CASSANDRA_HOME/rust/target/release/cassandra-tools" ]; then
    exec "$CASSANDRA_HOME/rust/target/release/cassandra-tools" auditlogviewer "$@"
elif [ -x "$CASSANDRA_HOME/rust/target/debug/cassandra-tools" ]; then
    exec "$CASSANDRA_HOME/rust/target/debug/cassandra-tools" auditlogviewer "$@"
else
    cd "$CASSANDRA_HOME/rust" || exit 1
    exec cargo run --bin cassandra-tools --quiet -- auditlogviewer "$@"
fi
