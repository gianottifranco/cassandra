#!/bin/sh

# sstableloader wrapper for Cassandra Rust rewrite

SCRIPT_DIR=$(dirname "$0")
CASSANDRA_HOME=$(cd "$SCRIPT_DIR/../.." && pwd)

# Execute the Rust cassandra-tools binary with the sstableloader subcommand
if [ -x "$CASSANDRA_HOME/rust/target/release/cassandra-tools" ]; then
    exec "$CASSANDRA_HOME/rust/target/release/cassandra-tools" sstableloader "$@"
elif [ -x "$CASSANDRA_HOME/rust/target/debug/cassandra-tools" ]; then
    exec "$CASSANDRA_HOME/rust/target/debug/cassandra-tools" sstableloader "$@"
else
    cd "$CASSANDRA_HOME/rust" || exit 1
    exec cargo run --bin cassandra-tools --quiet -- sstableloader "$@"
fi

