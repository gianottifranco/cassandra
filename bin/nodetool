#!/bin/sh

# nodetool wrapper for Cassandra Rust rewrite

# Parse arguments to extract -h/--host and -p/--port
HOST="127.0.0.1"
PORT="9090" # Admin API port

# Pass all other arguments to the rust tool
ARGS=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--host)
      HOST="$2"
      shift 2
      ;;
    -p)
      PORT="$2"
      shift 2
      ;;
    --port=*)
      PORT=$(echo "$1" | cut -d '=' -f 2)
      shift
      ;;
    --port)
      PORT="$2"
      shift 2
      ;;
    -u|--username|-pw|--password|--ssl|-D*|-jvm_arg)
      # Ignore Java/JMX specific args
      if [ "$1" = "-u" ] || [ "$1" = "--username" ] || [ "$1" = "-pw" ] || [ "$1" = "--password" ] || [ "$1" = "-jvm_arg" ]; then
          shift 2
      else
          shift 1
      fi
      ;;
    *)
      ARGS="$ARGS $1"
      shift
      ;;
  esac
done

SCRIPT_DIR=$(dirname "$0")
CASSANDRA_HOME=$(cd "$SCRIPT_DIR/.." && pwd)

# Execute the Rust cassandra-tools binary
if [ -x "$CASSANDRA_HOME/rust/target/release/cassandra-tools" ]; then
    exec "$CASSANDRA_HOME/rust/target/release/cassandra-tools" --host "$HOST" --port "$PORT" $ARGS
elif [ -x "$CASSANDRA_HOME/rust/target/debug/cassandra-tools" ]; then
    exec "$CASSANDRA_HOME/rust/target/debug/cassandra-tools" --host "$HOST" --port "$PORT" $ARGS
else
    cd "$CASSANDRA_HOME/rust" || exit 1
    exec cargo run --bin cassandra-tools --quiet -- --host "$HOST" --port "$PORT" $ARGS
fi
